# Copy this file to .env for local use, and add the same two variables
# in Vercel (Project -> Settings -> Environment Variables).
# Both values come from Supabase: Project Settings -> API.
# These two are PUBLIC keys (safe in the frontend). Never put the
# service_role key or any other secret here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
